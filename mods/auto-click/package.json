{
  "name": "auto-click",
  "displayName": "自动点击",
  "version": "0.5.0",
  "description": "开着的时候，按设定的间隔自动点击桌宠，增加点击数",
  "author": "Yueby",
  "modkit": {
    "defaultEnabled": false,
    "windows": { "main": "main.js" },
    "settings": [
      {
        "key": "interval",
        "type": "number",
        "title": "点击间隔（毫秒）",
        "description": "两次点击的间隔，50–5000，越小点得越快。角色的点击动画约 220 毫秒，间隔更短时爪子会一直按着",
        "default": 200,
        "min": 50,
        "max": 5000,
        "step": 10
      },
      { "key": "state", "type": "value", "title": "状态", "default": "未运行" },
      { "key": "sent", "type": "value", "title": "本次已点击", "default": "0 次" }
    ]
  }
}
