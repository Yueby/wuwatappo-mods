{
  "name": "auto-click",
  "displayName": "自动点击",
  "version": "0.4.0",
  "description": "按设定间隔模拟鼠标点击，增加点击数",
  "author": "Yueby",
  "modkit": {
    "windows": {
      "main": "main.js"
    },
    "settings": [
      {
        "key": "running",
        "type": "toggle",
        "title": "开始点击",
        "description": "开启后按设定间隔模拟点击。重启或重载后恢复为关闭，不会自己再开",
        "default": false,
        "persist": false
      },
      {
        "key": "interval",
        "type": "number",
        "title": "点击间隔（毫秒）",
        "description": "两次点击的间隔，50–5000，越小点得越快。角色的点击动画约 220 毫秒，间隔更短时爪子会一直按着",
        "default": 200,
        "min": 50,
        "max": 5000,
        "step": 10
      },
      {
        "key": "state",
        "type": "value",
        "title": "状态",
        "default": "未运行"
      },
      {
        "key": "sent",
        "type": "value",
        "title": "本次已发送",
        "default": "0 次"
      }
    ]
  }
}
