{
  "name": "pet-position",
  "displayName": "记住桌宠位置",
  "version": "0.3.2",
  "description": "记录自己和房间内其他玩家桌宠的位置，在重启软件或进入房间后自动还原",
  "author": "Yueby",
  "modkit": {
    "api": 2,
    "windows": {
      "main": "main.js",
      "panel": "panel.js"
    },
    "permissions": [
      "app-internals"
    ],
    "settings": [
      {
        "key": "restore",
        "type": "toggle",
        "title": "自动还原位置",
        "description": "桌宠位置被应用改动后，自动还原到记录的位置。关闭后仅保存位置，运行中不移动桌宠。",
        "default": true
      },
      {
        "key": "remembered",
        "type": "value",
        "title": "已记录的位置",
        "default": "无"
      },
      {
        "key": "state",
        "type": "value",
        "title": "状态",
        "default": "未运行"
      }
    ]
  }
}
