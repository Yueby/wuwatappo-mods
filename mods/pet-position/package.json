{
  "name": "pet-position",
  "displayName": "记住桌宠位置",
  "version": "0.1.0",
  "description": "记住最后一次亲手拖好的桌宠位置；重启软件或进房间后位置被挤动时，自动拖回去",
  "author": "Yueby",
  "modkit": {
    "windows": { "main": "main.js", "panel": "panel.js" },
    "settings": [
      {
        "key": "restore",
        "type": "toggle",
        "title": "位置被挤动后拖回去",
        "description": "关掉以后只保住软件存下的位置（重启时有用），不会在软件运行中移动桌宠",
        "default": true
      },
      { "key": "remembered", "type": "value", "title": "记住的位置", "default": "还没有" },
      { "key": "state", "type": "value", "title": "状态", "default": "未运行" }
    ]
  }
}
