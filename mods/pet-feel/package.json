{
  "name": "pet-feel",
  "displayName": "桌宠手感",
  "version": "0.5.0",
  "description": "桌宠的按压、拖拽、松手、点击和抛掷动效，带弹性、重力和旋转滚动，所有桌宠一致",
  "author": "Yueby",
  "modkit": {
    "api": 10,
    "permissions": [
      "app-internals"
    ],
    "windows": {
      "main": "main.js"
    },
    "settings": [
      {
        "key": "press",
        "type": "toggle",
        "title": "按压形变",
        "description": "按住桌宠时，身体向下压扁。",
        "default": true
      },
      {
        "key": "drag",
        "type": "toggle",
        "title": "拖拽摆动",
        "description": "拖动时桌宠被提起，并随拖动方向摆动。",
        "default": true
      },
      {
        "key": "release",
        "type": "toggle",
        "title": "松手回弹",
        "description": "松手后桌宠落下并回弹。",
        "default": true
      },
      {
        "key": "click",
        "type": "toggle",
        "title": "点击弹跳",
        "description": "快速点击时桌宠弹起。",
        "default": true
      },
      {
        "key": "throw",
        "type": "toggle",
        "title": "抛掷",
        "description": "拖动中快速松手，桌宠按手的速度飞出，碰到屏幕边缘反弹。关闭后仅放下。",
        "default": true
      },
      {
        "key": "spin",
        "type": "toggle",
        "title": "旋转滚动",
        "description": "抛出的桌宠会旋转，落地后滚动，停下后自己摆正。关闭后只按飞行方向倾斜。",
        "default": true
      },
      {
        "key": "gravity",
        "type": "toggle",
        "title": "重力",
        "description": "抛出的桌宠受重力下落，最后落在任务栏上。关闭后沿原方向滑行直至停下。",
        "default": true
      },
      {
        "key": "strength",
        "type": "number",
        "title": "动效强度",
        "description": "范围 0.5 到 2，默认 1。",
        "default": 1,
        "min": 0.5,
        "max": 2,
        "step": 0.1
      }
    ]
  }
}
